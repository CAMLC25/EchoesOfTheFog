  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Blackwood b\u1ECB phong t\u1ECFa sau \u0111\u1EE3t b\xF9ng ph\xE1t b\xE0o
    t\u1EED. Nh\u1EEFng ng\u01B0\u1EDDi d\xE2n nhi\u1EC5m b\u1EC7nh \u0111\xE3 tr\u1EDF
    th\xE0nh nh\u1EEFng k\u1EBB m\u1ED9ng du, v\xE0 qu\xE2n \u0111\u1ED9i chu\u1EA9n
    b\u1ECB ph\xE1 h\u1EE7y khu v\u1EF1c.\n\nElena, m\u1ED9t chuy\xEAn vi\xEAn qu\xE2n
    y, ti\u1EBFn v\xE0o thung l\u0169ng \u0111\u1EC3 t\xECm m\u1EABu d\u1ECBch chi\u1EBFt
    b\xE0o t\u1EED, c\u1EE9u em g\xE1i v\xE0 nh\u1EEFng ng\u01B0\u1EDDi s\u1ED1ng
    s\xF3t. Chi\u1EBFc xe t\u1EA3i c\u0169 l\xE0 hy v\u1ECDng \u0111\u01B0a m\u1ECDi
    ng\u01B0\u1EDDi tho\xE1t kh\u1ECFi Blackwood.\n\nTr\u01B0\u1EDBc m\u1EAFt l\xE0
    b\xECa r\u1EEBng. H\xE3y t\xECm v\u0169 kh\xED v\xE0 v\u01B0\u1EE3t qua nh\u1EEFng
    k\u1EBB m\u1ED9ng du \u0111\u1EC3 t\u1EDBi c\u1ED5ng l\xE0ng."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e301c28a27cd8c146bb63b0415ab75b9, type: 2}
